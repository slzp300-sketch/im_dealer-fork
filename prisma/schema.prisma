generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model FinanceCompany {
  id            String               @id @default(cuid())
  name          String               @unique
  code          String               @unique
  surchargeRate Float                @default(0)
  // 견적서 이미지의 "시나리오별 견적 비교" 테이블에 금융사명 옆 로고로 노출. 어드민 업로드 URL.
  logoUrl       String?
  isActive      Boolean              @default(true)
  displayOrder  Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  rateSheets    CapitalRateSheet[]
  inventories   Inventory[]
  scrapeJobs    ScrapeJob[]
  catalogTrims  CapitalCatalogTrim[]
  catalogModels CapitalCatalogModel[]
  trimMappings  CapitalTrimMapping[]
}

// 주별 캐피탈사 견적 입력 및 계산된 회수율 보관
model CapitalRateSheet {
  id                  String         @id @default(cuid())
  financeCompanyId    String
  trimId              String
  productType         String         @default("장기렌트") // "장기렌트" | "리스"
  weekOf              DateTime // 해당 주 시작일 (월요일 기준)
  // 가격 범위
  minVehiclePrice     Int // 최소 차량가
  maxVehiclePrice     Int // 최대 차량가
  // 캐피탈사 원본 견적 (최소가 기준)
  minBaseRates        Json // {"36_10000": 500000, ...} 최소가 기준 견적
  minDepositRates     Json // 최소가 + 보증금 10%
  minPrepayRates      Json // 최소가 + 선납금 10%
  // 캐피탈사 원본 견적 (최대가 기준)
  maxBaseRates        Json // {"36_10000": 540000, ...} 최대가 기준 견적
  maxDepositRates     Json // 최대가 + 보증금 10%
  maxPrepayRates      Json // 최대가 + 선납금 10%
  // 자동 계산 결과
  minRateMatrix       Json // 최소가 기준 회수율 매트릭스
  maxRateMatrix       Json // 최대가 기준 회수율 매트릭스
  depositDiscountRate Float // 보증금 할인 회수율 (min·max 평균)
  prepayAdjustRate    Float // 선납금 조정 회수율 (min·max 평균)
  isActive            Boolean        @default(true)
  memo                String?
  createdAt           DateTime       @default(now())
  financeCompany      FinanceCompany @relation(fields: [financeCompanyId], references: [id], onDelete: Cascade)
  trim                Trim           @relation(fields: [trimId], references: [id], onDelete: Cascade)

  @@unique([financeCompanyId, trimId, weekOf, productType])
  @@index([financeCompanyId, trimId])
  @@index([financeCompanyId, weekOf])
  @@index([isActive])
}

model RankSurchargeConfig {
  id   String @id @default(cuid())
  rank Int    @unique
  rate Float
}

model Brand {
  id           String   @id @default(cuid())
  name         String   @unique
  logoUrl      String?
  displayOrder Int      @default(0)
  // 인기 브랜드 그룹 플래그. 정렬에서 일반 브랜드보다 우선 표시되고,
  // 공개 페이지에서 "인기 브랜드" 섹션으로 묶어 보여줄 수 있다.
  isFeatured   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model Vehicle {
  id                     String                @id @default(cuid())
  slug                   String                @unique
  name                   String
  brand                  String
  category               String
  vehicleCode            String?
  // 외부 데이터 소스 식별자 (재임포트 멱등성)
  externalId             String?               @unique
  externalSource         String? // "external" 등 출처 식별 태그
  basePrice              Int
  thumbnailUrl           String
  imageUrls              String[]
  thumbnailImageId       String?               @unique
  imageRevision          Int                   @default(0)
  surchargeRate          Float                 @default(0)
  isVisible              Boolean               @default(true)
  isPopular              Boolean               @default(false)
  // 차량 탐색(/cars) 상단 "주목할 차량" 슬라이더 노출 플래그. isPopular(홈 인기차량)와 별개.
  isSpotlight            Boolean               @default(false)
  // 추천 자동검출 보정값. null=자동검출, true/false=운영자 강제. (AI 추천 가점용)
  slidingDoorOverride    Boolean?
  advancedSafetyOverride Boolean?
  displayOrder           Int                   @default(0)
  description            String?
  tags                   String[]
  detailedSpecs          Json?
  // 캐피탈사 회수율 스크래퍼 연결: { "ORIX": { "brandCd": "CA100002", "modelName": "쏘렌토" } }
  scraperRefs            Json?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  exploLogs              ExplorationLog[]
  notes                  OperationalNote[]
  quoteVars              QuoteVariable[]
  recConfigs             RecommendationConfig?
  recLogs                RecommendationLog[]
  trims                  Trim[]
  lineups                VehicleLineup[]
  popularConfigs         PopularConfig[]
  quoteCalcLogs          QuoteCalcLog[]
  reviews                Review[]
  colors                 VehicleColor[]
  optionBadges           VehicleOptionBadge[]
  // DB FK proves image existence only; API/policy must enforce thumbnailImage.vehicleId == Vehicle.id.
  thumbnailImage         VehicleImage?         @relation("VehicleRepresentativeImage", fields: [thumbnailImageId], references: [id], onDelete: SetNull)
  images                 VehicleImage[]        @relation("VehicleImages")

  @@index([isVisible, isPopular])
  @@index([isVisible, isSpotlight])
  @@index([category])
  @@index([vehicleCode])
  @@index([externalSource])
}

model Trim {
  id              String               @id @default(cuid())
  vehicleId       String
  name            String
  price           Int
  discountPrice   Int?
  // 전기차 보조금(안내용). 견적 계산에는 반영하지 않으며 화면 표기 전용. null=보조금 없음.
  evSubsidy       Int?
  engineType      String
  fuelEfficiency  Float?
  isDefault       Boolean              @default(false)
  // Carpan2 트림은 원본 판매 상태(state=2)를 반영한다. 최종 고객 노출은
  // Vehicle.isVisible && VehicleLineup.isVisible && Trim.isVisible 조건으로 판정한다.
  isVisible       Boolean              @default(true)
  specs           Json?
  // 외부 차량 데이터 소스 식별자 및 풍부한 메타(tm/division/displace/person/tax/spec/specoption/documents/colorPriceMap)
  externalId      String?              @unique
  detailedSpecs   Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  quoteVars       QuoteVariable[]
  lineupId        String?
  lineup          VehicleLineup?       @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  vehicle         Vehicle              @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  options         TrimOption[]
  rules           OptionRule[]
  inventory       Inventory[]
  rateSheets      CapitalRateSheet[]
  capitalMappings CapitalTrimMapping[]

  @@index([vehicleId])
  @@index([lineupId])
}

model VehicleLineup {
  id         String   @id @default(cuid())
  vehicleId  String
  name       String
  // 고객 노출 여부. 같은 차량군은 기본적으로 최신 연식만 노출되며,
  // 운영자가 예외적으로 특정 연식을 숨기거나 노출하려면 이 값을 제어한다.
  isVisible  Boolean  @default(true)
  // 외부 차량 데이터 소스 식별자 및 연식/엔진/가격대/연비 메타
  externalId String?  @unique
  metadata   Json?
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trims      Trim[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([vehicleId])
}

model TrimOption {
  id                 String              @id @default(cuid())
  trimId             String
  name               String
  price              Int                 @default(0)
  category           String?
  isDefault          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  description        String?
  isAccessory        Boolean             @default(false)
  // 고객 노출 순서(낮을수록 상단). 운영자가 어드민에서 드래그로 지정.
  displayOrder       Int                 @default(0)
  // 외부 차량 데이터 소스 옵션 ID (트림별로 같은 옵션이 반복되므로 trimId 와 함께 unique)
  externalId         String?
  metadata           Json? // kind/apply/guide/package/conditionFlag 등
  trim               Trim                @relation(fields: [trimId], references: [id], onDelete: Cascade)
  popularConfigItems PopularConfigItem[]
  rulesSource        OptionRule[]        @relation("SourceRule")
  rulesTarget        OptionRule[]        @relation("TargetRule")

  @@unique([trimId, externalId])
  @@index([trimId])
}

// 옵션 추천 배지 — 운영자가 추가/수정/삭제하는 전역 라벨 목록(추천/인기/베스트 등)
model OptionBadge {
  id           String               @id @default(cuid())
  label        String               @unique
  displayOrder Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  assignments  VehicleOptionBadge[]
}

// 차량 단위 "옵션명 → 배지" 매핑. 배지는 트림 옵션 행이 아니라 옵션명에 붙는다.
// 같은 이름의 옵션이 어느 트림/연식에 있든(재동기화로 새로 생겨도) 배지가 함께 노출된다.
model VehicleOptionBadge {
  id         String      @id @default(cuid())
  vehicleId  String
  // TrimOption.name 과 공백 정규화 후 매칭되는 옵션명. 차량 내 유일.
  optionName String
  badgeId    String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  badge      OptionBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, optionName])
  @@index([badgeId])
}

model OptionRule {
  id             String     @id @default(cuid())
  trimId         String
  ruleType       String // "REQUIRED" | "INCLUDED" | "CONFLICT"
  sourceOptionId String
  targetOptionId String
  trim           Trim       @relation(fields: [trimId], references: [id], onDelete: Cascade)
  sourceOption   TrimOption @relation("SourceRule", fields: [sourceOptionId], references: [id], onDelete: Cascade)
  targetOption   TrimOption @relation("TargetRule", fields: [targetOptionId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())

  @@index([trimId])
}

model PopularConfig {
  id           String              @id @default(cuid())
  vehicleId    String
  name         String
  note         String?
  displayOrder Int                 @default(0)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  vehicle      Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  items        PopularConfigItem[]

  @@index([vehicleId])
}

model PopularConfigItem {
  id           String        @id @default(cuid())
  configId     String
  name         String
  price        Int
  trimOptionId String?
  displayOrder Int           @default(0)
  config       PopularConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  trimOption   TrimOption?   @relation(fields: [trimOptionId], references: [id])

  @@index([configId])
}

model QuoteVariable {
  id             String    @id @default(cuid())
  vehicleId      String
  trimId         String?
  contractMonths Int[]
  annualMileages Int[]
  interestRate   Float
  residualRate   Float
  commissionRate Float
  taxRate        Float     @default(0.1)
  miscCost       Int       @default(0)
  depositOptions Int[]
  prepayOptions  Int[]
  promoDiscount  Int       @default(0)
  promoNote      String?
  promoExpiry    DateTime?
  isActive       Boolean   @default(true)
  memo           String?
  updatedAt      DateTime  @updatedAt
  updatedBy      String?
  trim           Trim?     @relation(fields: [trimId], references: [id])
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, trimId])
}

enum QuoteStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  CONVERTED
  LOST
}

enum QuotePricingStatus {
  CALCULATED
  CONSULTATION_REQUIRED
}

enum ColorKind {
  EXTERIOR
  INTERIOR
}

enum VehicleImageType {
  MAIN
  COVER
  EXTERIOR_COLOR
  INTERIOR_COLOR
  SPEC_EXTERIOR
  SPEC_INTERIOR
  SPEC_SEAT
  SPEC_OPTION
  CATALOG_PAGE
}

enum VehicleImageOrigin {
  CARPAN2
  ADMIN
}

enum VehicleImageStorageCleanupReason {
  UPLOAD_ROLLBACK
  IMAGE_PURGE
  VEHICLE_DELETE
}

enum VehicleImageStorageCleanupStatus {
  RESERVED
  READY
  PROCESSING
  // 삭제가 MAX_ATTEMPTS회 반복 실패한 poison job. claimCleanup 후보에서 제외되며
  // 운영자가 readStorageCleanupState로 확인 후 수동 조치(readStorageCleanupState/re-enqueue).
  DEAD
}

model VehicleColor {
  id         String    @id @default(cuid())
  vehicleId  String
  kind       ColorKind
  name       String
  hexCode    String
  imageUrl   String?
  priceDelta Int       @default(0)
  isDefault  Boolean   @default(false)
  sortOrder  Int       @default(0)
  // 외부 차량 데이터 소스 식별자 및 제조사 컬러 코드 (예: "WAW"), rgb2/group/호환규칙
  externalId String?
  mfgCode    String?
  metadata   Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  vehicle    Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  exteriorOf SavedQuote[] @relation("SavedQuoteExteriorColor")
  interiorOf SavedQuote[] @relation("SavedQuoteInteriorColor")

  @@unique([vehicleId, kind, externalId])
  @@index([vehicleId, kind, sortOrder])
}

model VehicleImage {
  id                       String             @id @default(cuid())
  vehicleId                String
  type                     VehicleImageType
  origin                   VehicleImageOrigin @default(CARPAN2)
  title                    String?
  storageUrl               String
  sourceUrl                String?
  sourceKey                String
  adminStoragePath         String?            @unique
  listThumbnailUrl         String?
  listThumbnailStoragePath String?
  displayOrder             Int                @default(0)
  isVisible                Boolean            @default(true)
  deletedAt                DateTime?
  metadata                 Json?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  vehicle          Vehicle  @relation("VehicleImages", fields: [vehicleId], references: [id], onDelete: Cascade)
  representativeOf Vehicle? @relation("VehicleRepresentativeImage")

  @@unique([vehicleId, sourceKey])
  @@index([vehicleId, type, isVisible, displayOrder])
  @@index([sourceUrl])
  @@index([listThumbnailStoragePath])
}

model VehicleImageStorageCleanup {
  id               String                           @id @default(cuid())
  storagePath      String                           @unique
  reason           VehicleImageStorageCleanupReason
  status           VehicleImageStorageCleanupStatus @default(RESERVED)
  reservationToken String?
  availableAt      DateTime                         @default(now())
  leaseToken       String?
  leaseExpiresAt   DateTime?
  attempts         Int                              @default(0)
  lastError        String?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @default(now()) @updatedAt

  @@index([status, availableAt])
  @@index([leaseExpiresAt])
}

model SavedQuote {
  id                    String             @id @default(cuid())
  sessionId             String             @unique
  userId                String?
  vehicleId             String
  trimId                String
  contractMonths        Int
  annualMileage         Int
  depositRate           Int
  prepayRate            Int
  contractType          String
  customerType          String             @default("individual")
  monthlyPayment        Int
  totalCost             Int
  pricingStatus         QuotePricingStatus @default(CALCULATED)
  breakdown             Json
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  expiresAt             DateTime
  deletedAt             DateTime?
  // 로그인 전 견적의 소유권을 로그인 후 안전하게 연결하는 브라우저 capability 해시.
  // 실제 capability 값은 HttpOnly cookie 에만 두고 DB에는 SHA-256 해시만 저장한다.
  verificationCapabilityHash String? @map("verificationSessionId")
  customerName          String?
  phone                 String?

  quoteType String @default("DETAIL") // "AI" | "DETAIL"

  // CRM 필드
  status       QuoteStatus @default(NEW)
  assigneeId   String?
  internalMemo String?
  contactedAt  DateTime?
  convertedAt  DateTime?

  // 색상 선택
  exteriorColorId String?
  interiorColorId String?
  exteriorColor   VehicleColor? @relation("SavedQuoteExteriorColor", fields: [exteriorColorId], references: [id])
  interiorColor   VehicleColor? @relation("SavedQuoteInteriorColor", fields: [interiorColorId], references: [id])

  activityLogs QuoteActivityLog[]
  reviews      Review[]
  reviewTokens ReviewRequestToken[]

  @@index([status])
  @@index([pricingStatus])
  @@index([assigneeId])
  @@index([userId])
  @@index([expiresAt])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([exteriorColorId])
  @@index([interiorColorId])
}

model QuoteActivityLog {
  id        String   @id @default(cuid())
  quoteId   String
  actorId   String
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  quote SavedQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model RecommendationLog {
  id                    String    @id @default(cuid())
  sessionId             String
  industry              String
  purpose               String
  budgetMin             Int
  budgetMax             Int
  paymentStyle          String
  annualMileage         Int
  returnType            String
  recommendedVehicleIds String[]
  recommendedReason     Json
  // 추천 결과 전체(차량3대 + 이유 + 시나리오 가격) freeze 스냅샷.
  // 새로고침/뒤로 시 재계산·LLM 없이 그대로 반환. SQL NULL만 옛 로그 재계산 폴백.
  result                Json?
  industryDetail        String?
  // 「원하는 차」 선호 특징 (신규 흐름). 옛 세션은 purpose/purposeDetail 사용.
  preferences           String[]  @default([])
  childDetail           String?
  cargoDetail           String?
  purposeDetail         String?
  budgetDetail          String?
  fuelPreference        String?
  chargingEnvironment   String?
  residenceRegion       String?
  clickedVehicleId      String?
  clickedAt             DateTime?
  proceedToQuote        Boolean   @default(false)
  vehicleId             String?
  createdAt             DateTime  @default(now())
  userAgent             String?
  ipHash                String?
  vehicle               Vehicle?  @relation(fields: [vehicleId], references: [id])

  @@index([sessionId])
  @@index([createdAt])
}

model ExplorationLog {
  id        String   @id @default(cuid())
  sessionId String
  eventType String
  path      String?
  vehicleId String?
  metadata  Json?
  createdAt DateTime @default(now())
  userAgent String?
  ipHash    String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([sessionId])
  @@index([eventType, createdAt])
}

model QuoteCalcLog {
  id        String  @id @default(cuid())
  sessionId String
  userId    String?

  // ── 입력 조건 (독립 컬럼 → SQL 집계·ML 학습에 최적) ──
  vehicleId         String
  vehicleSlug       String
  vehicleName       String?
  vehicleBrand      String?
  trimId            String?
  trimName          String?
  trimPrice         Int?
  discountPrice     Int?
  optionIds         String[]
  optionSnapshots   Json?
  extraOptionsPrice Int      @default(0)
  optionsTotalPrice Int      @default(0)
  exteriorColorId   String?
  exteriorColorName String?
  interiorColorId   String?
  interiorColorName String?
  colorDelta        Int      @default(0)
  totalVehiclePrice Int?
  contractMonths    Int
  annualMileage     Int
  depositRate       Float // 0, 10, 20, 30 등
  prepayRate        Float // 0, 10, 20, 30 등
  contractType      String // 반납형 / 인수형
  productType       String // 장기렌트 / 리스
  customerType      String?

  // ── 계산 결과 (독립 컬럼) ──
  resultMonthly      Int // 최종 월 납입금
  bestFinanceCompany String
  scenarioType       String // conservative / standard / aggressive
  pricingStatus      QuotePricingStatus @default(CALCULATED)
  // 차량가 + 옵션가가 회수율 시트 범위(min~max)를 초과한 경우 true.
  // 어드민 대시보드 "범위 초과 견적" 위젯에서 집계 — 회수율 데이터 보강 신호.
  rangeExceeded      Boolean            @default(false)

  // ── 행동 추적 ──
  clickedApply Boolean @default(false) // 계약 신청 클릭 여부

  // ── 메타 ──
  deviceType   String?
  referrer     String?
  userAgent    String?
  ipHash       String?
  createdAt    DateTime @default(now())
  calculatedAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@unique([sessionId, vehicleSlug, scenarioType], map: "QuoteCalcLog_session_vehicle_scenario_key")
  @@index([vehicleSlug, createdAt])
  @@index([sessionId])
  @@index([userId])
  @@index([vehicleId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([calculatedAt])
  @@index([scenarioType, createdAt])
  @@index([rangeExceeded, createdAt])
}

model QuotaLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  computedAt      DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  totalBytes      BigInt   @map("total_bytes") @db.BigInt
  attachmentCount Int      @map("attachment_count") @db.Integer

  @@index([computedAt(sort: Desc)], map: "quota_log_computed_at_idx")
  @@map("quota_log")
}

model RecommendationConfig {
  id          String   @id @default(cuid())
  vehicleId   String   @unique
  scoreMatrix Json
  highlights  String[]
  aiCaption   String?
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedBy   String?
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

model OperationalNote {
  id        String   @id @default(cuid())
  vehicleId String?
  category  String
  title     String   @default("")
  content   String
  isPinned  Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([category, isPinned])
}

model User {
  id               String    @id @default(cuid())
  supabaseId       String?   @unique // Supabase auth user.id 와의 1:1 연결
  email            String? // 카카오 이메일 미동의 케이스 수용 위해 nullable, unique 해제
  passwordHash     String? // 레거시 JWT 인증 잔재. 추후 컬럼 자체 제거 예정.
  name             String
  role             String    @default("member") // "member" | "dealer" | "staff" | "admin" | "superadmin"
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  phone            String?
  provider         String? // "kakao" 등
  kakaoId          String?   @unique // 카카오 회원번호(앱별 고유). 싱크·메시지 발송의 키.
  kakaoNickname    String?
  channelRelation  String? // "ADDED" | "BLOCKED" | "NONE" — 카카오톡 채널 추가 상태
  // 카카오 리프레시 토큰. 견적서 전송 시 액세스 토큰 재발급에 사용.
  // 평문 저장 금지 — src/lib/pii.ts 의 encryptString/decryptString 만 거칠 것.
  kakaoRefreshToken String?
  marketingConsent Boolean   @default(false)
  consentedAt      DateTime? // 카카오싱크 동의창을 통과한 시각(재동의 시 갱신)
  profileCompleted Boolean   @default(false) // 간편가입 폼(이름·전화) 완료 여부. 미완료 회원은 로그인 후 /welcome 로 유도.
  // 간편가입 완료 시각. 추천인 코드 사후 입력 창구(REFERRAL_ENTRY_WINDOW_DAYS) 판정 기준.
  profileCompletedAt DateTime?
  // 추천인 코드: 알파벳1 + 숫자4 (예: K4821). 가입 시 발급, 기존 회원은 백필/첫 방문 시 발급.
  referralCode     String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  auditLogs       AdminAuditLog[]
  quoteDeliveries QuoteDelivery[]
  coupons         IssuedCoupon[]
  referralsGiven  Referral[]      @relation("ReferralsGiven")
  referralReceived Referral?      @relation("ReferralReceived")
  adminNotificationReads AdminNotificationRead[]

  @@index([role, isActive])
  @@index([email])
  @@index([channelRelation])
}

enum ReferralStatus {
  REWARDED
  BLOCKED
  REVOKED
}

// 추천 인정 원장. referee 1회, referrer 월 한도·감사 추적.
model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  refereeId    String         @unique
  code         String
  status       ReferralStatus @default(REWARDED)
  signupIpHash String?
  createdAt    DateTime       @default(now())

  referrer User           @relation("ReferralsGiven", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User           @relation("ReferralReceived", fields: [refereeId], references: [id], onDelete: Cascade)
  coupons  IssuedCoupon[]

  @@index([referrerId, createdAt])
}

// 견적서 카카오톡 전송 이력. 재발송·실패 추적·관리자 모니터링의 근거.
model QuoteDelivery {
  id            String    @id @default(cuid())
  userId        String
  savedQuoteId  String? // 전송 시점의 SavedQuote (없을 수도 있어 nullable)
  vehicleName   String
  imagePath     String // Storage 경로 (PNG)
  channel       String    @default("memo") // "alimtalk"(채널 알림톡) | "memo"(구 나에게 보내기)
  status        String    @default("PENDING") // PENDING | SENT | FAILED
  failReason    String?
  sentAt        DateTime?
  // 공개 PNG lifecycle state. 정리 실패는 전송 상태와 분리해 기록하고 다음 크론에서 재시도한다.
  imageDeletedAt             DateTime?
  imageCleanupAttempts       Int       @default(0)
  imageCleanupLastAttemptAt   DateTime?
  imageCleanupError           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([imageDeletedAt, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  resource   String
  targetId   String?
  diff       Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([resource, targetId])
  @@index([action, createdAt])
}

model CustomerVerification {
  id                String    @id @default(cuid())
  sessionId         String
  // SavedQuote.userId 와 같은 Supabase Auth user id. 기존 무소유 레코드는 nullable 로 유지한다.
  userId            String?
  customerType      String
  connectedId       String?
  licenseVerified   Boolean   @default(false)
  insuranceVerified Boolean   @default(false)
  bizVerified       Boolean   @default(false)
  licenseData       Json?
  insuranceData     Json?
  bizData           Json?
  consentedAt       DateTime
  verifiedAt        DateTime?
  piiPurgedAt       DateTime? // 성공 인증의 90일 retention 후 cron 이 PII를 비운 시각
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  documents VerificationDocument[]

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@index([verifiedAt, piiPurgedAt])
}

// 간편인증으로 발급받은 공문서(PDF) 원본 저장. contentEnc 는 AES-256-GCM 암호화.
// 성공 문서는 90일 후 PII를 비우며, 실패·대기 문서는 마지막 활동 7일 후 행을 삭제한다.
model VerificationDocument {
  id             String               @id @default(cuid())
  verificationId String
  verification   CustomerVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  docType        String // DocType enum 문자열 (resident_register 등)
  status         String               @default("pending") // pending | issued | failed
  fileName       String?
  mimeType       String?              @default("application/pdf")
  contentEnc     Json? // AES-256-GCM EncryptedBlob (base64 PDF)
  docVerifyNo    String? // 문서확인번호 (암호화 문자열) — 제3자 진위확인용
  failReason     String?
  issuedAt       DateTime?
  piiPurgedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([verificationId])
}

model Review {
  id             String      @id @default(cuid())
  authorRealName String
  rating         Int
  content        String
  vehicleId      String?
  vehicle        Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  savedQuoteId   String?
  savedQuote     SavedQuote? @relation(fields: [savedQuoteId], references: [id], onDelete: SetNull)
  isPublic       Boolean     @default(true)
  isBest         Boolean     @default(false)
  displayOrder   Int         @default(0)
  likeCount      Int         @default(0)
  reviewDate     DateTime    @default(now())
  imageUrls      String[]    @default([])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  requestToken ReviewRequestToken?
  likes        ReviewLike[]

  @@index([vehicleId, isPublic, displayOrder])
  @@index([isPublic, displayOrder])
  @@index([isPublic, isBest, displayOrder])
  @@index([isPublic, likeCount])
}

model ReviewLike {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  anonId    String
  createdAt DateTime @default(now())

  @@unique([reviewId, anonId])
  @@index([reviewId])
  @@index([anonId])
}

model ReviewRequestToken {
  id               String              @id @default(cuid())
  token            String              @unique
  savedQuoteId     String
  savedQuote       SavedQuote          @relation(fields: [savedQuoteId], references: [id], onDelete: Cascade)
  expiresAt        DateTime
  usedAt           DateTime?
  revokedAt        DateTime?
  reviewId         String?             @unique
  review           Review?             @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  imageUploadCount Int                 @default(0)
  imageUploadBytes Int                 @default(0)
  imageUploads     ReviewImageUpload[]
  createdAt        DateTime            @default(now())
  createdById      String?

  @@index([savedQuoteId])
  @@index([expiresAt])
}

model ReviewImageUpload {
  id                   String             @id @default(cuid())
  reviewRequestTokenId String
  reviewRequestToken   ReviewRequestToken @relation(fields: [reviewRequestTokenId], references: [id], onDelete: Cascade)
  path                 String             @unique
  url                  String             @unique
  byteSize             Int
  contentType          String
  usedAt               DateTime?
  createdAt            DateTime           @default(now())

  @@index([reviewRequestTokenId, usedAt])
}

model Inventory {
  id                String          @id @default(cuid())
  trimId            String
  stockCount        Int             @default(0)
  location          String?
  status            String          @default("AVAILABLE") // AVAILABLE, RESERVED, SOLD
  colorExt          String?
  colorInt          String?
  vin               String?         @unique
  memo              String?
  financeCompanyId  String?
  immediateDelivery Boolean         @default(false)
  selectedOptions   String[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  trim              Trim            @relation(fields: [trimId], references: [id], onDelete: Cascade)
  financeCompany    FinanceCompany? @relation(fields: [financeCompanyId], references: [id], onDelete: SetNull)

  @@index([trimId])
  @@index([financeCompanyId])
  @@index([status])
  @@index([updatedAt])
}

model AdminNotification {
  id        String   @id @default(cuid())
  type      String // "NEW_QUOTE", "SYSTEM", "INQUIRY"
  title     String
  content   String
  linkUrl   String?
  // 하위 호환 컬럼. 읽음 판정 SSOT 는 AdminNotificationRead(관리자별)이다.
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  reads AdminNotificationRead[]

  @@index([isRead])
  @@index([createdAt])
}

// 관리자별 알림 읽음 기록 — 읽음 판정 SSOT.
// 어드민 계정은 User(role 기반) 이므로 adminUserId 는 User.id 를 가리킨다.
// 1명이 읽어도 다른 관리자의 읽지 않음 상태가 유지된다(전역 isRead 대체).
model AdminNotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  adminUserId    String
  readAt         DateTime @default(now())

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  adminUser    User              @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([notificationId, adminUserId])
  @@index([adminUserId])
}

// 스크래핑 작업 큐 (어드민이 생성 → 로컬 워커가 폴링/클레임/완료)
// 로그인 자격증명은 저장하지 않는다. 각 관리자가 가져오기 할 때마다 입력한 ID/PW 를
// AES-256-GCM 암호문으로 이 작업에만 임시 저장하고, 완료/실패/취소 시 즉시 폐기(null)한다.
model ScrapeJob {
  id               String         @id @default(cuid())
  financeCompanyId String
  jobType          String         @default("trim_rates") // trim_rates(차량·트림 지정 수집) | catalog(브랜드 전량 수집)
  status           String         @default("pending") // pending|running|needs_human|completed|failed|canceled
  productType      String         @default("장기렌트")
  params           Json // trim_rates: { trimIds, vehicleId, ... } / catalog: { mode:"catalog", brands, weekOf, productType }
  credUsernameEnc  String? // encryptString(평문 ID) — 진행 중에만 존재, 종료 시 null
  credPasswordEnc  String? // encryptString(평문 PW) — 진행 중에만 존재, 종료 시 null
  credentialExpiresAt DateTime? // 생성 후 24시간. 활성 heartbeat 작업은 유지하고 stale 작업만 purge
  leaseToken       String?        @unique // claim 세대별 임의 토큰. stale worker 후속 쓰기 차단
  workerId         String? // 이 작업을 처리할 워커. null 이면 아무 워커나 집는다(기존 동작)
  draft            Json? // trim_rates: ScrapeDraft / catalog: CatalogScrapeSummary (워커가 채움)
  progress         Json? // catalog 잡 진행률 (워커 하트비트가 갱신)
  error            String?
  humanPrompt      String? // needs_human 일 때 운영자 안내문
  claimedAt        DateTime?
  heartbeatAt      DateTime? // 워커 생존 신호 (스테일 작업 회수용)
  finishedAt       DateTime?
  createdById      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  financeCompany   FinanceCompany @relation(fields: [financeCompanyId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([status, credentialExpiresAt])
  @@index([status, workerId])
  @@index([financeCompanyId, status])
}

// 이름 있는 수집 PC(SCRAPER_WORKER_ID)의 마지막 생존 신호.
// 워커의 claim 폴링(5초)·heartbeat(30초)마다 갱신되며, 작업 생성 시
// "그 이름의 워커가 지금 켜져 있는지"를 판정해 잘못된 이름의 무한 대기를 막는다.
model ScrapeWorkerPresence {
  workerId   String   @id
  lastSeenAt DateTime
}

// 캐피탈사 원본 카탈로그 — 캐피탈사에 등록된 트림 단위 견적(월납입금 9칸)의 최신본.
// (financeCompanyId, productType, mdelCd) 당 1행 upsert. 주별 이력은 반영 후 CapitalRateSheet 가 담당.
// 캐피탈사 브랜드별 차량(모델) 목록.
// 트림 견적까지 긁지 않고 목록만 동기화해 둔다 — 수집 대상 차량을 고르려면 목록이 먼저 필요한데,
// 트림 수집으로 목록을 얻으려면 브랜드 전량(수십 분)을 한 번 돌려야 하는 모순이 있었다.
model CapitalCatalogModel {
  id               String         @id @default(cuid())
  financeCompanyId String
  productType      String         @default("장기렌트")
  brandCd          String
  brandName        String
  modelCd          String
  modelName        String
  syncedAt         DateTime // 마지막 목록 동기화 시각
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  financeCompany   FinanceCompany @relation(fields: [financeCompanyId], references: [id], onDelete: Cascade)

  // 기본 생성명이 Postgres 식별자 63자를 넘어 잘리므로 이름을 고정한다.
  @@unique([financeCompanyId, productType, brandCd, modelCd], map: "CapitalCatalogModel_fc_pt_brand_model_key")
  @@index([financeCompanyId, productType, brandCd], map: "CapitalCatalogModel_fc_pt_brand_idx")
}

model CapitalCatalogTrim {
  id                  String               @id @default(cuid())
  financeCompanyId    String
  productType         String               @default("장기렌트")
  brandCd             String // 캐피탈사 브랜드코드 (ORIX: CA1000xx)
  brandName           String // 표시용 ("현대" 등)
  modelCd             String // ORIX MDL_CD
  modelName           String // ORIX MDL_NM
  dtMdlCd             String // ORIX DT_MDL_CD (세부차종)
  dtMdlName           String?
  mdelCd              String // ORIX MDEL_CD (외부 트림코드)
  trimName            String // ORIX MDEL_NAME2
  modelYear           String? // ORIX MDEL_YEAR
  vehiclePrice        Int // ORIX MDEL_PRICE
  baseRates           Json // RATE_KEYS 9칸 월납입금(원), 0=미산출
  residualRates       Json? // 기간×거리별 잔가율(0~1, `${months}_${distKm}` 키) — 엑셀 수집분 검증·재계산용. null=미수집(스크래핑 등)
  depositRate36_10000 Int? // 36개월/1만km 보증금10% 월납입금(원), null=미수집
  prepayRate36_10000  Int? // 36개월/1만km 선납금10% 월납입금(원), null=미수집
  warnings            Json?
  weekOf              DateTime // 마지막 수집 주 (월요일)
  scrapedAt           DateTime
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  financeCompany      FinanceCompany       @relation(fields: [financeCompanyId], references: [id], onDelete: Cascade)
  mappings            CapitalTrimMapping[]

  @@unique([financeCompanyId, productType, mdelCd])
  @@index([financeCompanyId, brandCd])
  @@index([financeCompanyId, weekOf])
}

// 우리 트림 ↔ 카탈로그 트림 매핑 (자동 제안 채택 또는 수동 선택, 관리자 확정 원칙)
model CapitalTrimMapping {
  id               String             @id @default(cuid())
  financeCompanyId String
  trimId           String
  productType      String             @default("장기렌트")
  catalogTrimId    String
  source           String // 'auto' | 'manual'
  confidence       String? // auto 일 때 'exact' | 'fuzzy'
  externalMdelCd   String // 스냅샷 (연식 변경 감지용)
  externalLabel    String // 스냅샷 (trimName + [연식])
  createdById      String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  financeCompany   FinanceCompany     @relation(fields: [financeCompanyId], references: [id], onDelete: Cascade)
  trim             Trim               @relation(fields: [trimId], references: [id], onDelete: Cascade)
  catalogTrim      CapitalCatalogTrim @relation(fields: [catalogTrimId], references: [id], onDelete: Cascade)

  @@unique([financeCompanyId, trimId, productType])
  @@index([catalogTrimId])
}

// NICE D&R 공개 모델별 연료타입 순위 월간 스냅샷.
// entries에는 휘발유·경유·하이브리드·전기 각 1~30위 공개 원문과
// 내부 차량 slug 매핑 결과를 한 JSON 배치로 보관해 일부 연료만 갱신되지 않게 한다.
// 외부 모델이 아직 우리 카탈로그에 없으면 slug는 null로 남겨 다음 수집 때 다시 매핑한다.
model RecommendationPopularitySnapshot {
  id        String   @id @default(cuid())
  period    String   @unique // YYYY-MM
  sourceUrl String
  fetchedAt DateTime
  entries   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fetchedAt])
}

enum CouponTrigger {
  SIGNUP
  FIRST_CONTRACT
  REFERRAL_RECEIVED // 피추천인(가입한 사람)
  REFERRAL_GIVEN    // 추천인(초대한 사람)
}

enum CouponStatus {
  HELD
  PENDING
  PAID
  EXPIRED
  REVOKED
}

// 어드민이 관리하는 쿠폰 캠페인 정의.
model CouponPolicy {
  id           String        @id @default(cuid())
  code         String        @unique
  trigger      CouponTrigger
  title        String
  description  String?
  rewardLabel  String
  rewardAmount Int?
  rewardKind   String        @default("GIFT")
  termsNote    String?
  validDays    Int?
  isActive     Boolean       @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  coupons IssuedCoupon[]

  @@index([trigger, isActive])
}

// 회원이 실제로 보유한 쿠폰 한 장.
model IssuedCoupon {
  id       String       @id @default(cuid())
  userId   String
  policyId String
  code     String       @unique
  status   CouponStatus @default(HELD)

  // 발급 시점 스냅샷. 정책이 바뀌어도 고객에게 약속한 내용은 고정된다.
  titleSnapshot        String
  rewardLabelSnapshot  String
  rewardAmountSnapshot Int?

  issuedAt  DateTime  @default(now())
  expiresAt DateTime?

  qualifiedQuoteId String?
  qualifiedAt      DateTime?
  paidAt           DateTime?
  paidBy           String?
  paidMemo         String?
  revokedAt        DateTime?
  revokeReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 추천 쿠폰이면 해당 Referral 행에 연결. 중복 방지 유니크는 DB 부분 유니크 2개로
  // 존재한다(Prisma 는 partial unique 를 표현하지 못해 여기 선언하지 않는다):
  //   IssuedCoupon_nonreferral_unique (userId, policyId)     WHERE referralId IS NULL
  //   IssuedCoupon_referral_unique    (policyId, referralId) WHERE referralId IS NOT NULL
  // 20260819000000_issued_coupon_partial_uniques 마이그레이션이 유지한다.
  // @@unique([userId, policyId]) 풀 유니크는 REFERRAL_GIVEN(추천인이 피추천인마다
  // 발급, 월 상한 10건) 다중 보유와 충돌하므로 선언하지 않는다.
  referralId String?

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  policy   CouponPolicy  @relation(fields: [policyId], references: [id])
  referral Referral?     @relation(fields: [referralId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([status, issuedAt])
  @@index([referralId])
}

// 알림톡(비즈톡 BGMS) 발송 큐 겸 이력.
// 견적서 외 용도(상담 접수·후기 요청)로도 쓰므로 QuoteDelivery 와 분리한다.
//
// 고정 IP 화이트리스트 때문에 발송은 Vercel 이 아니라 릴레이(scripts/biztalk-relay)가
// 수행한다. 앱은 PENDING 행을 쌓고, 릴레이가 클레임해서 보낸 뒤 결과를 되돌려준다.
// id(cuid) 를 그대로 비즈톡 msgIdx 로 쓰므로(25자 ≤ Text(40)) 리스 만료로 같은 행이
// 재발송돼도 비즈톡이 중복(3012)으로 걸러낸다 → 고객에게 카톡이 두 번 가지 않는다.
model AlimtalkMessage {
  id           String  @id @default(cuid())
  templateKey  String // 코드 내부 식별자 (QUOTE_DELIVERED 등)
  templateCode String // 검수 승인된 tmpltCode
  recipient    String // 암호화 저장 (src/lib/pii.ts encryptString)
  message      String // 변수 치환이 끝난 최종 본문. 템플릿과 글자 단위로 일치해야 한다.
  buttons      Json? // attach.button[] 원형

  userId  String?
  refType String? // "quote" | "consult" | "review"
  refId   String?

  status       String  @default("PENDING") // PENDING | SENDING | ACCEPTED | SENT | FAILED
  responseCode String? // 접수 결과 (1000 = 접수 성공, 도달 아님)
  resultCode   String? // 전송 결과 (1000 = 도달)
  sendType     String? // K 카카오 | E 결과미수신
  uid          String? // 비즈톡 메시지 ID
  failReason   String?

  attempts   Int     @default(0)
  leaseToken String? // 릴레이 클레임 토큰 (ScrapeJob 과 동일 방식)

  claimedAt DateTime?
  sentAt    DateTime?
  resultAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([refType, refId])
}

// 즉시출고 재고 업로드 배치 — 브랜드별 엑셀 1회 업로드 = 1배치. 적용 시 같은 브랜드의 이전 배치·행 전체 교체(스냅샷).
model ImmediateDeliveryBatch {
  id          String                   @id @default(cuid())
  brand       String // "기아" | "현대" | "르노" (파서 추가 시 확장)
  fileName    String
  rowCount    Int
  vehicleCount Int // quantity 합계
  warnings    Json? // 파싱 경고 (스킵된 시트/행 등)
  createdById String
  createdAt   DateTime                 @default(now())
  rows        ImmediateDeliveryStock[]

  @@index([brand, createdAt])
}

// 즉시출고 가능 차량 — 제조사 재고리스트 엑셀의 통합 정규화 행. 브랜드별 최신 배치의 행만 존재.
model ImmediateDeliveryStock {
  id            String                 @id @default(cuid())
  batchId       String
  brand         String // "기아" | "현대" | "르노"
  model         String // 시트명 기반 모델명 (카니발, 싼타페, 그랑콜레오스 등)
  stockType     String // "NORMAL"(정상) | "LIMITED"(한정/조건)
  salesCode     String? // 판매코드 (르노는 모델코드)
  trimName      String // 차종 상세
  optionText    String?
  exteriorColor String?
  interiorColor String?
  price         Int?
  discount      Int? // 판매조건계(원). 르노는 시트명의 한정액
  quantity      Int    @default(1) // 기아·현대 한정 시트는 1행 = 1대
  location      String? // 출하지/출고센터 등
  extra         Json? // 브랜드 특화 필드 (생산번호, 생산일, 할인 세부내역 등)
  createdAt     DateTime               @default(now())
  batch         ImmediateDeliveryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([brand, model])
  @@index([brand, stockType])
}
