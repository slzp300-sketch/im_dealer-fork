# 아임딜러 앱
# apex 로 둘 것. www 는 apex 로 301 되는데, 리다이렉트를 따라갈 때 Authorization
# 헤더가 떨어져 워커 API 가 401 로 막힌다.
APP_BASE_URL=https://imdealer.co.kr
ALIMTALK_RELAY_SECRET=            # Vercel 환경변수와 같은 값

# 비즈톡 크리덴셜 (이 서버에만 둔다 — Vercel 에는 넣지 않는다)
BIZTALK_BSID=
BIZTALK_PASSWD=
BIZTALK_SENDER_KEY=               # 발신프로필키

# 선택
BIZTALK_API_HOST=https://www.biztalk-api.com
BIZTALK_TEST_MODE=false           # true 면 사전 등록된 테스트 번호로만 발송(과금은 동일)
RELAY_SEND_POLL_MS=5000
RELAY_RESULT_POLL_MS=30000
